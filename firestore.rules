rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for validationRecord entity
    function isValidValidationRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'status', 'quantumHash', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.status in ['approved', 'rejected', 'flagged']
        && data.quantumHash is string && data.quantumHash.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 200))
        && (!('curp' in data) || (data.curp is string && data.curp.size() <= 30))
        && (!('claveElector' in data) || (data.claveElector is string && data.claveElector.size() <= 30))
        && (!('biometricMatchScore' in data) || data.biometricMatchScore is number)
        && (!('livenessScore' in data) || data.livenessScore is number)
        && (!('latticeKeyId' in data) || (data.latticeKeyId is string && data.latticeKeyId.size() <= 128))
        && (!('ineModel' in data) || (data.ineModel is string && data.ineModel.size() <= 50))
        && (!('auditLogCount' in data) || data.auditLogCount is number);
    }

    // Validation for userProfile entity
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Validations collection
    match /validations/{validationId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(validationId)
        && isValidValidationRecord(incoming())
        && incoming().id == validationId;
      allow update: if isSignedIn() && isValidId(validationId)
        && existing().userId == request.auth.uid
        && isValidValidationRecord(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'auditLogCount']);
      allow delete: if false; // Immutable audit trail
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }
  }
}
